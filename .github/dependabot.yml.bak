# Dependabot opens a pull request when an action used in .github/workflows has a newer release:
# the actions are pinned to commit SHAs, and it updates the SHA and the version comment together
# (the pinned checkout, upload-artifact and download-artifact still run on Node 20). Cargo
# dependencies are updated by hand (see docs/releasing.md).
version: 2
updates:
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
