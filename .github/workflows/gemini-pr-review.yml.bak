name: Gemini PR Code Review (Direct API)

on:
  pull_request:
    types: [opened, synchronize]

permissions:
  contents: read
  pull-requests: write

jobs:
  review:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Analyze Git Diff with Gemini API
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          GH_TOKEN: ${{ secrets.GEMINI_GITHUB_TOKEN }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        run: |
          # 1. ดึงเฉพาะส่วนของโค้ดที่เปลี่ยนแปลง (จำกัดขนาดไม่ให้เกินขีดจำกัด)
          git diff origin/${{ github.base_ref }}...HEAD > changes.diff
          
          if [ ! -s changes.diff ]; then
            echo "ไม่มีการเปลี่ยนแปลงของโค้ด"
            exit 0
          fi

          # 2. สร้าง JSON Payload ด้วย jq เพื่อป้องกันปัญหาอักขระพิเศษในโค้ด
          jq -n --rawfile diff changes.diff '{
            contents: [{
              parts: [{
                text: ("คุณคือ Senior Developer ช่วยทำ Code Review จาก git diff ต่อไปนี้ โดยสรุปสั้นๆ ถึงจุดที่ควรแก้ไข บั๊ก หรือช่องโหว่ (ตอบเป็นภาษาไทย):\n\n" + $diff)
              }]
            }]
          }' > payload.json

          # 3. ยิง Request ไปที่ Gemini 2.5 Flash API
          curl -s -X POST "https://generativelanguage.googleapis.com/v1beta/models/gemini-4-argon:generateContent?key=${GEMINI_API_KEY}" \
            -H "Content-Type: application/json" \
            -d @payload.json > response.json

          # 4. ดึงข้อความตอบกลับจาก JSON
          jq -r '.candidates[0].content.parts[0].text // "ไม่สามารถสร้างคำแนะนำได้ ตรวจสอบ API Key หรือ Quota"' response.json > review_comment.md

          # 5. โพสต์คอมเมนต์ลงใน Pull Request ด้วย GitHub CLI
          gh pr comment "$PR_NUMBER" --body-file review_comment.md
