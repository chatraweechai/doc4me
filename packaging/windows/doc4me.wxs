<?xml version="1.0" encoding="utf-8"?>
<!--
  Doc4Me MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build doc4me.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=... -o out.msi

  Per-machine install into Program Files with a Start Menu shortcut. The installer shows the
  standard WiX dialogs: welcome + license, progress, and a finish page.

  UpgradeCode and the component GUIDs below belong to Doc4Me alone. Never copy them from (or
  into) a sibling Craft app: Windows Installer treats every package sharing an UpgradeCode as one
  product, so a shared code makes one app's installer refuse to install ("a newer version is
  already installed") or silently uninstall the other. packaging-lint.yml checks this.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Doc4Me"
      Manufacturer="Doc4Me contributors"
      Version="$(var.Version)"
      UpgradeCode="C0B6B9B1-C22E-4EDA-8C0C-ACE61578CD4D"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Doc4Me word processor" Manufacturer="Doc4Me contributors" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Doc4Me is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="Doc4meIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="Doc4meIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/chatraweechai/doc4me" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/chatraweechai/doc4me" />
    <Property Id="ARPHELPLINK" Value="https://github.com/chatraweechai/doc4me/issues" />

    <!-- Installer UI (#198): WixUI_Minimal is welcome + license, progress, then a finish page so
         people can see the install worked. Its dialogs and bitmaps are WiX's own
         (WixToolset.UI.wixext); package.ps1 builds the license RTF from LICENSE-MIT and
         LICENSE-APACHE. The finish page offers to launch Doc4Me (ticked by default) through
         WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Doc4Me" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#Doc4meExe]" />
    <CustomAction Id="LaunchDoc4me" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchDoc4me"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Doc4Me" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Doc4Me" Level="1">
      <ComponentGroupRef Id="Doc4meFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="Doc4meFiles" Directory="INSTALLFOLDER">
      <Component Id="Doc4meApp" Guid="B2E58F9A-FB7C-4A43-B2BB-65550EC7732A">
        <File Id="Doc4meExe" Source="$(var.BinDir)\doc4me.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Doc4Me"
              Description="Doc4Me word processor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="Doc4meIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\doc4me.exe" Value="[#Doc4meExe]" Type="string" />
      </Component>

      <!-- NOTICE, the Unicode license of the word dictionaries and the license texts of the fonts
           compiled into doc4me.exe: the SIL Open Font License asks every copy of the fonts to
           carry it. -->
      <Component Id="Doc4meLicenses" Guid="BF94546B-2D9A-4A8A-BBC0-90E51151711E">
        <File Id="NoticeTxt" Source="$(var.RootDir)\NOTICE" Name="NOTICE.txt" KeyPath="yes" />
        <File Id="LicenseUnicode" Source="$(var.RootDir)\LICENSE-UNICODE" Name="LICENSE-UNICODE.txt" />
        <File Id="OflSarabun" Source="$(var.RootDir)\assets\fonts\OFL-Sarabun.txt" />
        <File Id="OflInter" Source="$(var.RootDir)\assets\fonts\OFL-Inter.txt" />
        <File Id="OflSourceSans3" Source="$(var.RootDir)\assets\fonts\OFL-SourceSans3.txt" />
        <File Id="OflSourceSerif4" Source="$(var.RootDir)\assets\fonts\OFL-SourceSerif4.txt" />
        <File Id="OflJetBrainsMono" Source="$(var.RootDir)\assets\fonts\OFL-JetBrainsMono.txt" />
        <File Id="OflIntos" Source="$(var.RootDir)\assets\fonts\OFL-Intos.txt" />
      </Component>

      <!-- File associations (#295). Each document type gets a Doc4Me ProgId (name, icon, open
           command) and is listed under the extension's OpenWithProgids, so Doc4Me shows in
           Explorer's "Open with". The Word, RTF and ODT types are also Doc4Me's Capabilities
           (RegisteredApplications), so it appears in Settings › Default apps, where the user
           makes it the default (File › Options › General opens that page). Nothing here sets an
           extension's default: the installer never takes over .docx from another app. Markdown and
           plain text are only "Open with" candidates. Removed again on uninstall. -->
      <Component Id="Doc4meFileTypes" Guid="97FD4DD9-4805-4003-9F9C-E573C8A5BB8B">
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="Doc4Me" Value="Software\Doc4Me\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Doc4Me\Capabilities" Name="ApplicationName" Value="Doc4Me" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Doc4Me\Capabilities" Name="ApplicationDescription" Value="Write and design documents; open and save Word files." Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Doc4Me\Capabilities" Name="ApplicationIcon" Value="&quot;[#Doc4meExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\doc4me.exe" Name="FriendlyAppName" Value="Doc4Me" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\doc4me.exe\shell\open\command" Value="&quot;[#Doc4meExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="Doc4Me.Document" Description="Word Document" Icon="Doc4meExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Doc4Me.Document\shell\open\command" Value="&quot;[#Doc4meExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docx\OpenWithProgids" Name="Doc4Me.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\doc4me.exe\SupportedTypes" Name=".docx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Doc4Me\Capabilities\FileAssociations" Name=".docx" Value="Doc4Me.Document" Type="string" />

        <ProgId Id="Doc4Me.DocumentMacroEnabled" Description="Word Macro-Enabled Document" Icon="Doc4meExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Doc4Me.DocumentMacroEnabled\shell\open\command" Value="&quot;[#Doc4meExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docm\OpenWithProgids" Name="Doc4Me.DocumentMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\doc4me.exe\SupportedTypes" Name=".docm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Doc4Me\Capabilities\FileAssociations" Name=".docm" Value="Doc4Me.DocumentMacroEnabled" Type="string" />

        <ProgId Id="Doc4Me.Template" Description="Word Template" Icon="Doc4meExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Doc4Me.Template\shell\open\command" Value="&quot;[#Doc4meExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotx\OpenWithProgids" Name="Doc4Me.Template" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\doc4me.exe\SupportedTypes" Name=".dotx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Doc4Me\Capabilities\FileAssociations" Name=".dotx" Value="Doc4Me.Template" Type="string" />

        <ProgId Id="Doc4Me.TemplateMacroEnabled" Description="Word Macro-Enabled Template" Icon="Doc4meExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Doc4Me.TemplateMacroEnabled\shell\open\command" Value="&quot;[#Doc4meExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotm\OpenWithProgids" Name="Doc4Me.TemplateMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\doc4me.exe\SupportedTypes" Name=".dotm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Doc4Me\Capabilities\FileAssociations" Name=".dotm" Value="Doc4Me.TemplateMacroEnabled" Type="string" />

        <ProgId Id="Doc4Me.LegacyDocument" Description="Legacy Word Document" Icon="Doc4meExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Doc4Me.LegacyDocument\shell\open\command" Value="&quot;[#Doc4meExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.doc\OpenWithProgids" Name="Doc4Me.LegacyDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\doc4me.exe\SupportedTypes" Name=".doc" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Doc4Me\Capabilities\FileAssociations" Name=".doc" Value="Doc4Me.LegacyDocument" Type="string" />

        <ProgId Id="Doc4Me.LegacyTemplate" Description="Legacy Word Template" Icon="Doc4meExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Doc4Me.LegacyTemplate\shell\open\command" Value="&quot;[#Doc4meExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dot\OpenWithProgids" Name="Doc4Me.LegacyTemplate" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\doc4me.exe\SupportedTypes" Name=".dot" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Doc4Me\Capabilities\FileAssociations" Name=".dot" Value="Doc4Me.LegacyTemplate" Type="string" />

        <ProgId Id="Doc4Me.RichText" Description="Rich Text Document" Icon="Doc4meExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Doc4Me.RichText\shell\open\command" Value="&quot;[#Doc4meExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.rtf\OpenWithProgids" Name="Doc4Me.RichText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\doc4me.exe\SupportedTypes" Name=".rtf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Doc4Me\Capabilities\FileAssociations" Name=".rtf" Value="Doc4Me.RichText" Type="string" />

        <ProgId Id="Doc4Me.OpenDocumentText" Description="OpenDocument Text" Icon="Doc4meExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Doc4Me.OpenDocumentText\shell\open\command" Value="&quot;[#Doc4meExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.odt\OpenWithProgids" Name="Doc4Me.OpenDocumentText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\doc4me.exe\SupportedTypes" Name=".odt" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Doc4Me\Capabilities\FileAssociations" Name=".odt" Value="Doc4Me.OpenDocumentText" Type="string" />

        <ProgId Id="Doc4Me.Markdown" Description="Markdown Document" Icon="Doc4meExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Doc4Me.Markdown\shell\open\command" Value="&quot;[#Doc4meExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.md\OpenWithProgids" Name="Doc4Me.Markdown" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\doc4me.exe\SupportedTypes" Name=".md" Value="" Type="string" />

        <ProgId Id="Doc4Me.PlainText" Description="Text Document" Icon="Doc4meExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Doc4Me.PlainText\shell\open\command" Value="&quot;[#Doc4meExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.txt\OpenWithProgids" Name="Doc4Me.PlainText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\doc4me.exe\SupportedTypes" Name=".txt" Value="" Type="string" />
      </Component>

      <Component Id="Doc4meCli">
        <File Id="Doc4meCliExe" Source="$(var.BinDir)\doc4me-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
