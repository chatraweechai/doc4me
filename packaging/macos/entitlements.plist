<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for Doc4me. The app loads no unsigned code, needs no JIT, and
     is not sandboxed (it opens files by path, from the command line and drag-and-drop). The one
     exception is the microphone, for Dictate. Add exceptions here only with a reason in a comment. -->
<plist version="1.0">
<dict>
  <!-- Home › Dictate: the hardened runtime blocks the microphone without this. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
